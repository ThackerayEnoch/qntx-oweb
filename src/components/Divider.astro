---
interface Props {
  theme?: 'light' | 'dark';
  class?: string;
}

const { theme = 'light', class: className = '' } = Astro.props;
const isDark = theme === 'dark';
---

<div
  data-expand-divider
  class={`w-full h-px origin-left scale-x-0 transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] ${isDark ? 'bg-neutral-800' : 'bg-neutral-200'} ${className}`.trim()}
  aria-hidden="true"
></div>

