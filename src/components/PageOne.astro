---
// PageOne.astro - The Kinetic ASCII Sculpture & Web3 Terminal Focus
---

<div class="w-full flex flex-col items-center justify-center my-auto py-2 sm:py-6 select-none">
  
  <!-- The Real-Time Kinetic ASCII Canvas (Borderless, Floating) -->
  <div class="relative w-full max-w-[880px] h-[280px] sm:h-[360px] md:h-[400px] cursor-crosshair overflow-hidden">
    <canvas
      id="qntx-ascii-canvas"
      class="w-full h-full block"
      aria-label="Interactive QNTX ASCII horizontal unfolding animation"
    ></canvas>
  </div>

  <!-- Bottom Slogan (Uppercase Monospace, Zero Extra Spacing Above) -->
  <div class="text-center pt-2 sm:pt-4">
    <h1 class="font-mono text-xs sm:text-sm tracking-[0.22em] text-neutral-950 uppercase font-medium">
      Economic Layer for Autonomous AI Agents
    </h1>
  </div>

  <!-- Terminal Style Code Snippet (Seamless, Borderless, No Button Box) -->
  <div class="flex justify-center pt-2.5 sm:pt-3">
    <div
      id="cmd-container"
      class="group cursor-pointer inline-flex items-center gap-2 text-xs font-mono text-neutral-500 hover:text-neutral-950 transition-colors"
      title="Click to copy command"
      role="button"
      tabindex="0"
    >
      <span class="text-neutral-400 select-none">$</span>
      <span id="cmd-text" class="text-neutral-900 tracking-wider">bun add @quantx/core</span>
      <span
        id="cmd-feedback"
        class="text-[10px] text-neutral-400 uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all select-none ml-0.5"
      >
        [copy]
      </span>
    </div>
  </div>

</div>
