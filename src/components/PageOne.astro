---
// PageOne.astro - Page 01: Core Spec & Horizontal ASCII Unfold
---

<section id="page-1" class="min-h-[calc(100vh-3rem)] flex flex-col justify-between py-6 sm:py-8 border-b border-black/8">
  
  <!-- Section Header / Technical Coordinates -->
  <div class="flex items-center justify-between border-b border-black/10 pb-2 text-[11px] font-mono text-neutral-500">
    <div class="flex items-center gap-2">
      <span class="text-emerald-600">■</span>
      <span class="tracking-wider uppercase text-neutral-900 font-medium">[ 01 // CORE UNFOLD ]</span>
    </div>
    <div class="flex items-center gap-3 text-neutral-400">
      <span class="hidden sm:inline">RFC-0402</span>
      <span>RUNTIME_OK</span>
    </div>
  </div>

  <!-- Centerpiece: Horizontal Unfolding ASCII Canvas & Tagline -->
  <div class="my-auto py-4 space-y-5">
    
    <!-- ASCII Stage Container -->
    <div class="border border-black/12 bg-white p-4 sm:p-6 shadow-xs relative">
      
      <!-- Top Stage Bar: Scrubbing & Controls -->
      <div class="flex items-center justify-between border-b border-black/8 pb-2.5 mb-4 text-[11px] font-mono text-neutral-500">
        <div class="flex items-center gap-2">
          <span class="text-neutral-400">STAGE:</span>
          <span class="text-neutral-900 font-display">ASCII // HORIZON</span>
          <span id="unfold-pct" class="text-emerald-700 ml-1 font-semibold">100%</span>
        </div>

        <div class="flex items-center gap-3">
          <label class="hidden sm:flex items-center gap-2 text-neutral-400">
            <span>EXPAND:</span>
            <input
              id="unfold-slider"
              type="range"
              min="8"
              max="100"
              value="100"
              class="w-20 sm:w-28 accent-neutral-900 cursor-pointer h-1.5 bg-neutral-200"
              aria-label="Horizontal ASCII expansion slider"
            />
          </label>

          <button
            id="unfold-replay-btn"
            type="button"
            class="px-2 py-0.5 border border-black/15 bg-neutral-50 hover:bg-neutral-900 hover:text-white transition-all cursor-pointer font-mono text-[10px] uppercase text-neutral-700"
            title="Replay horizontal ASCII unfolding animation"
          >
            REPLAY ↺
          </button>
        </div>
      </div>

      <!-- The Horizontal Unfolding ASCII Artwork -->
      <div class="overflow-x-auto select-none py-2 flex justify-center no-scrollbar">
        <pre
          id="ascii-unfold-display"
          class="font-mono text-[10px] sm:text-[13px] md:text-[15px] lg:text-[16px] leading-[1.15] text-neutral-950 whitespace-pre tracking-normal text-center select-none"
          aria-label="QNTX Horizontal Unfolding ASCII Art"
        ></pre>
      </div>

      <!-- Bottom Frame Micro Coordinate -->
      <div class="flex items-center justify-between border-t border-black/6 pt-2 mt-3 text-[10px] font-mono text-neutral-400">
        <span>X_BOUND: 00..54</span>
        <span class="hidden sm:inline">KINETIC_INTERPOLATION</span>
        <span>SYS // 2026</span>
      </div>

    </div>

    <!-- Impact Statement (Extremely Minimal Words) -->
    <div class="text-center space-y-1.5 pt-2">
      <h1 class="font-display text-lg sm:text-2xl md:text-3xl text-neutral-950 uppercase tracking-widest font-normal">
        Autonomous Agent Protocol
      </h1>
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-widest">
        Compute. Transact. Evolve.
      </p>
    </div>

    <!-- Drop-in Quick Install Chip -->
    <div class="flex justify-center pt-1">
      <div class="inline-flex items-center gap-3 px-3 py-1.5 border border-black/15 bg-white shadow-2xs font-mono text-xs">
        <span class="text-neutral-400 select-none">$</span>
        <span id="cmd-text" class="text-neutral-900 font-medium select-all">bun add @qntx/core</span>
        <button
          id="copy-cmd-btn"
          type="button"
          class="ml-2 px-1.5 py-0.5 border border-black/20 text-[10px] text-neutral-700 hover:text-black hover:border-black transition-all cursor-pointer font-mono bg-neutral-50"
          aria-label="Copy install command"
        >
          COPY
        </button>
      </div>
    </div>

  </div>

  <!-- LiveData Telemetry Bar (Machine-to-Machine Heartbeat) -->
  <div class="border border-black/10 bg-white p-3.5 sm:p-4 shadow-xs">
    
    <!-- Telemetry Ticker Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/10 pb-2 mb-2.5 font-mono text-[11px]">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 pulse-emerald"></span>
        <span class="text-neutral-900 font-display tracking-wider">LIVEDATA // TELEMETRY PULSE</span>
      </div>

      <div class="flex items-center gap-4 text-neutral-600">
        <div>TPS: <span id="stat-tps" class="text-emerald-700 font-bold font-mono">3,420</span></div>
        <div>LATENCY: <span id="stat-latency" class="text-neutral-900 font-mono">4.2ms</span></div>
        <div class="hidden sm:inline">NODES: <span id="stat-agents" class="text-neutral-900 font-mono font-medium">14,820</span></div>
      </div>
    </div>

    <!-- Live Transaction Stream & ASCII Waveform Oscilloscope -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center font-mono">
      <!-- Live Transaction Feed -->
      <div class="md:col-span-8 overflow-hidden">
        <div id="live-tx-feed" class="space-y-1 text-xs" aria-live="polite"></div>
      </div>

      <!-- Real-time ASCII Oscilloscope -->
      <div class="md:col-span-4 border-t md:border-t-0 md:border-l border-black/10 pt-2 md:pt-0 md:pl-4">
        <pre
          id="ascii-waveform"
          class="font-mono text-xs leading-none text-neutral-900 select-none py-1"
          aria-label="Live ASCII waveform chart"
        ></pre>
        <div class="text-[10px] text-neutral-400 pt-1.5 border-t border-black/8 flex justify-between">
          <span>SPECTRUM:</span>
          <span class="text-emerald-700 select-none">■ ■ ▪ ■ ■ ▪ ■ ■</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Page Navigation Hint -->
  <div class="pt-4 flex items-center justify-between font-mono text-[11px] text-neutral-400">
    <div class="flex items-center gap-2">
      <span class="text-neutral-900">01</span>
      <span class="text-neutral-300">──▪──</span>
      <span>02</span>
    </div>
    <a
      href="#page-2"
      class="hover:text-black transition-colors flex items-center gap-1 text-neutral-700"
    >
      <span>PRIMITIVES</span>
      <span>↓</span>
    </a>
  </div>

</section>
