---
// PageOne.astro - Center Stage: Kinetic ASCII Squares Sculpture & Core Slogan
---

<div class="w-full flex flex-col items-center justify-center my-auto py-4 sm:py-6 select-none">
  
  <!-- The Real-Time Kinetic ASCII Canvas (Borderless, Floating) -->
  <div class="relative w-full max-w-[900px] h-[300px] sm:h-[360px] md:h-[400px] cursor-crosshair overflow-hidden">
    <canvas
      id="qntx-ascii-canvas"
      class="w-full h-full block focus:outline-none"
      role="img"
      aria-label="Animation: AI agents earn, pay and scale"
      tabindex="0"
    ></canvas>
  </div>

  <!-- Progress Indicator (3 small squares: 16px, 1px black border, filled = current, empty = other) -->
  <div
    id="canvas-progress"
    class="flex items-center justify-center gap-3 pt-3 select-none"
    role="tablist"
    aria-label="Animation Scenes"
  >
    <button
      type="button"
      data-scene-btn="0"
      aria-label="Scene 1"
      class="w-4 h-4 border border-black transition-colors focus:outline-none cursor-pointer bg-transparent"
    ></button>
    <button
      type="button"
      data-scene-btn="1"
      aria-label="Scene 2"
      class="w-4 h-4 border border-black transition-colors focus:outline-none cursor-pointer bg-transparent"
    ></button>
    <button
      type="button"
      data-scene-btn="2"
      aria-label="Scene 3"
      class="w-4 h-4 border border-black transition-colors focus:outline-none cursor-pointer bg-transparent"
    ></button>
  </div>

  <!-- Central Hierarchy: Slogan & Refined Action -->
  <div class="text-center pt-3 sm:pt-4 space-y-4">
    <h1 class="font-mono text-xs sm:text-[13px] md:text-sm tracking-[0.24em] text-neutral-800 uppercase font-medium select-none">
      Economic Layer for Autonomous AI Agents
    </h1>

    <div class="pt-1">
      <a
        id="get-started-btn"
        data-hero-cta
        href="https://docs.qntx.org"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 px-3.5 py-1.5 font-mono text-xs tracking-wider text-neutral-800 hover:text-black border border-black/15 hover:border-black bg-white/80 hover:bg-neutral-950 hover:text-white transition-all duration-150 shadow-2xs select-none"
        aria-label="Get Started with QuantX"
      >
        <span class="text-neutral-400 group-hover:text-neutral-500 transition-colors select-none">[</span>
        <span class="font-medium">GET STARTED</span>
        <span class="text-neutral-400 group-hover:text-neutral-300 transition-transform group-hover:translate-x-0.5 select-none">→</span>
        <span class="text-neutral-400 group-hover:text-neutral-500 transition-colors select-none">]</span>
      </a>
    </div>
  </div>

</div>

<script>
  import { initHeroCanvas } from "@/scripts/hero-canvas";
  initHeroCanvas();
</script>
