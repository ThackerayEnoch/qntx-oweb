---
interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const {
  href = "/",
  label = "QNTX",
  class: className = "h-10 w-auto text-black md:h-14 overflow-visible",
} = Astro.props;
---

<a href={href} class="inline-block shrink-0" aria-label={label}>
  <svg
    viewBox="-150 -150 300 300"
    xmlns="http://www.w3.org/2000/svg"
    class={className}
    shape-rendering="geometricPrecision"
    aria-hidden="true"
    data-brand-mark
  >
    <g data-q-root="true">
      <path
        data-q-id="body"
        fill="currentColor"
        fill-rule="evenodd"
        d="M-67.7647,-135.5294H67.7647A67.7647,67.7647,0,0,1,135.5294,-67.7647V67.7647A67.7647,67.7647,0,0,0,67.7647,135.5294H-67.7647A67.7647,67.7647,0,0,1,-135.5294,67.7647V-67.7647A67.7647,67.7647,0,0,1,-67.7647,-135.5294ZM-45.1765,-45.1765H45.1765V45.1765H-45.1765Z"
      />
      <path data-q-eye="left" fill="#ffffff" d="M0 0Z" display="none" />
      <path data-q-eye="right" fill="#ffffff" d="M0 0Z" display="none" />
    </g>
  </svg>
</a>

<script>
  import "../scripts/logo-animation.js";
</script>
