---
// PageTwo.astro - Page 02: Foundational Primitives & Interactive Swarm Mesh
---

<section id="page-2" class="min-h-[calc(100vh-3rem)] flex flex-col justify-between py-6 sm:py-8">
  
  <!-- Technical Line -->
  <div class="flex items-center justify-between border-b border-black/10 pb-2 text-[11px] font-mono text-neutral-500">
    <div class="flex items-center gap-2">
      <span class="text-neutral-900">■</span>
      <span class="tracking-wider uppercase text-neutral-900 font-medium">[ 02 // PRIMITIVES ]</span>
    </div>
    <div class="text-neutral-400">
      <span>OPEN ARCHITECTURE</span>
    </div>
  </div>

  <div class="my-auto py-3 sm:py-5 space-y-5">
    
    <!-- 4 Architectural Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono">
      
      <!-- Core Runtime -->
      <a
        href="https://github.com/qntx/core"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[RUNTIME]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/core
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          Autonomous agent execution state machine and event scheduler.
        </div>
      </a>

      <!-- Mesh Network -->
      <a
        href="https://github.com/qntx/mesh"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[P2P]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/mesh
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          Decentralized peer-to-peer discovery and agent state consensus.
        </div>
      </a>

      <!-- Vault Security -->
      <a
        href="https://github.com/qntx/vault"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[CRYPTO]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/vault
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          Non-custodial cryptographic key derivation and secret management.
        </div>
      </a>

      <!-- Pulse Telemetry -->
      <a
        href="https://github.com/qntx/pulse"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[TELEMETRY]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/pulse
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          High-throughput telemetry streaming and zero-friction micropayments.
        </div>
      </a>

    </div>

    <!-- Interactive Swarm Canvas -->
    <div class="border border-black/10 bg-white font-mono shadow-2xs overflow-hidden">
      <div class="flex items-center justify-between border-b border-black/8 px-3.5 py-2 text-[11px] text-neutral-500">
        <div class="flex items-center gap-2">
          <span class="text-neutral-400 select-none">[ SWARM TOPOLOGY ]</span>
          <span class="text-neutral-900 font-medium">DECENTRALIZED MESH</span>
        </div>
        <div class="text-neutral-400 text-[10px]">
          INTERACTIVE_P2P
        </div>
      </div>

      <div class="relative w-full h-[150px] sm:h-[180px] bg-white cursor-pointer">
        <canvas
          id="qntx-swarm-canvas"
          class="w-full h-full block"
          aria-label="Interactive decentralized agent swarm mesh"
        ></canvas>
      </div>

      <div class="flex items-center justify-between border-t border-black/6 px-3.5 py-1.5 text-[10px] text-neutral-400">
        <span>CLICK NODE TO PULSE</span>
        <span class="text-emerald-700">TOPOLOGY: ADAPTIVE</span>
      </div>
    </div>

  </div>

  <!-- Minimalist Technical Footer -->
  <footer class="pt-3 border-t border-black/10 flex flex-wrap items-center justify-between gap-4 font-mono text-[11px] text-neutral-500">
    <div class="flex items-center gap-3">
      <span class="text-neutral-950 font-display font-medium">[ QNTX ]</span>
      <span>QNANTX RESEARCH</span>
      <span class="hidden sm:inline text-neutral-400">MIT LICENSE</span>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://github.com/qntx"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black transition-colors"
      >
        GITHUB ↗
      </a>
      <a
        href="https://x.com/qntxorg"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black transition-colors"
      >
        X / TWITTER ↗
      </a>
      <a
        href="#page-1"
        class="text-neutral-900 hover:text-black font-semibold transition-colors"
      >
        [ TOP ↑ ]
      </a>
    </div>
  </footer>

</section>
