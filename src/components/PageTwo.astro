---
// PageTwo.astro - Page 02: Open Primitives & Real-time ASCII Swarm Matrix
---

<section id="page-2" class="min-h-[calc(100vh-3rem)] flex flex-col justify-between py-6 sm:py-8">
  
  <!-- Technical Line -->
  <div class="flex items-center justify-between border-b border-black/10 pb-2 text-[11px] font-mono text-neutral-500">
    <div class="flex items-center gap-2">
      <span class="text-neutral-900">■</span>
      <span class="tracking-wider uppercase text-neutral-900 font-medium">[ 02 // PRIMITIVES ]</span>
    </div>
    <div class="text-neutral-400">
      <span>MIT OPEN ARCHITECTURE</span>
    </div>
  </div>

  <div class="my-auto py-4 space-y-6">
    
    <!-- 4 Primitives Cards (Clean White Architectural Spec) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 font-mono">
      
      <!-- Core Runtime -->
      <a
        href="https://github.com/qntx/core"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[RUNTIME]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/core
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          Autonomous agent execution state machine and event scheduler.
        </div>
      </a>

      <!-- Mesh Network -->
      <a
        href="https://github.com/qntx/mesh"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[P2P]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/mesh
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          Decentralized peer-to-peer discovery and agent state consensus.
        </div>
      </a>

      <!-- Vault Security -->
      <a
        href="https://github.com/qntx/vault"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[CRYPTO]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/vault
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          Non-custodial cryptographic key derivation and secret management.
        </div>
      </a>

      <!-- Pulse Telemetry -->
      <a
        href="https://github.com/qntx/pulse"
        target="_blank"
        rel="noopener noreferrer"
        class="blueprint-card p-4 group block"
      >
        <div class="flex justify-between items-center text-xs text-neutral-400 mb-2">
          <span class="text-emerald-700 font-semibold">[TELEMETRY]</span>
          <span class="group-hover:text-black group-hover:translate-x-0.5 transition-all">↗</span>
        </div>
        <div class="font-display text-base text-neutral-950 mb-1 tracking-wide">
          qntx/pulse
        </div>
        <div class="text-xs text-neutral-600 leading-normal">
          High-throughput telemetry streaming and zero-friction micropayments.
        </div>
      </a>

    </div>

    <!-- Live ASCII Swarm Grid (Visual Matrix Representation) -->
    <div class="border border-black/10 bg-white p-4 font-mono shadow-2xs">
      <div class="flex items-center justify-between border-b border-black/8 pb-2 mb-3 text-[11px] text-neutral-500">
        <div class="flex items-center gap-2">
          <span class="text-neutral-400">[ SWARM MESH TOPOLOGY ]</span>
        </div>
        <div class="text-neutral-400 text-[10px]">
          INTER-AGENT DYNAMICS
        </div>
      </div>

      <div class="overflow-x-auto py-1 flex justify-center no-scrollbar select-none">
        <pre
          id="ascii-swarm-grid"
          class="font-mono text-xs sm:text-sm leading-relaxed text-neutral-900 tracking-widest text-center"
          aria-label="ASCII Swarm Node Grid"
        ></pre>
      </div>

      <div class="flex items-center justify-between border-t border-black/6 pt-2 mt-2 text-[10px] text-neutral-400">
        <span>TOPOLOGY: DECENTRALIZED</span>
        <span class="text-emerald-700">ACTIVE: 100%</span>
      </div>
    </div>

  </div>

  <!-- Minimalist Technical Footer -->
  <footer class="pt-4 border-t border-black/10 flex flex-wrap items-center justify-between gap-4 font-mono text-[11px] text-neutral-500">
    <div class="flex items-center gap-3">
      <span class="text-neutral-950 font-display">[ QNTX ]</span>
      <span>QNANTX RESEARCH</span>
      <span class="hidden sm:inline text-neutral-400">MIT LICENSE</span>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://github.com/qntx"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black transition-colors"
      >
        GITHUB ↗
      </a>
      <a
        href="https://x.com/qntxorg"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black transition-colors"
      >
        X / TWITTER ↗
      </a>
      <a
        href="#page-1"
        class="text-neutral-900 hover:text-black font-semibold transition-colors"
      >
        [ TOP ↑ ]
      </a>
    </div>
  </footer>

</section>
