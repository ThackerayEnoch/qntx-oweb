---
---

<section
  data-cta-banner
  class="relative overflow-hidden bg-black py-24 text-white md:py-32"
>
  <canvas
    data-voxel-field
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"
  ></canvas>
  <div class="relative mx-auto flex max-w-4xl flex-col items-center px-6 text-center">
    <div
      data-q-slot
      class="mb-8 h-24 w-24"
      aria-hidden="true"
    ></div>
    <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-neutral-700 bg-neutral-900 px-3.5 py-1">
      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
      <span class="font-label-tag text-label-tag font-medium uppercase tracking-wider text-neutral-300">
        GET STARTED TODAY
      </span>
    </div>
    <h2 class="font-display text-display-mobile mb-6 max-w-3xl font-semibold tracking-tight md:text-display">
      Ready to build agents that pay for themselves?
    </h2>
    <p class="font-body-lg text-body-lg mb-10 max-w-2xl text-neutral-400">
      Integrate the x402 client in 3 lines of code. Deploy your autonomous agent economic enclave on Monad testnet today.
    </p>
    <a
      class="inline-flex items-center gap-2 rounded-xl bg-white px-8 py-3.5 font-code-sm text-code-sm font-medium text-black shadow-sm transition-colors duration-100 hover:bg-neutral-200"
      href="https://github.com/qntx"
      rel="noreferrer"
      target="_blank"
    >
      <span>Get Started on GitHub →</span>
    </a>
  </div>
</section>

<script>
  import { r as reducedMotionQuery } from "../scripts/media.js";

  const cycleDuration = 16000;
  const phases = [
    { name: "drift", ms: 4000 },
    { name: "form", ms: 2800 },
    { name: "hold", ms: 5200 },
    { name: "scatter", ms: 4000 },
  ];
  const voxels = [[0, 0], [1, 0], [2, 0], [0, 1], [2, 1], [0, 2], [1, 2]].map(
    ([col, row], index) => ({ col, row, seed: seeded(index) }),
  );

  function phaseAt(time: number) {
    let localTime = (time % cycleDuration + cycleDuration) % cycleDuration;
    for (const phase of phases) {
      if (localTime < phase.ms) {
        return { name: phase.name, local: localTime / phase.ms };
      }
      localTime -= phase.ms;
    }
    return { name: "scatter", local: 1 };
  }

  function phaseProgress(name: string, local: number) {
    if (name === "drift") return 0;
    if (name === "hold") return 1;
    return name === "form" ? smoothstep(local) : 1 - smoothstep(local);
  }

  function pose(voxel: { col: number; row: number; seed: number }, time: number, scale = 1.15) {
    const phase = phaseAt(time);
    const progress = phaseProgress(phase.name, phase.local);
    const scatter = 1 - progress;
    const wave = Math.sin(voxel.col * 1.2 + voxel.row * 0.8 + time * 0.0035 + voxel.seed);
    const offset = scale * scatter;
    return {
      dx: Math.sin(time * 0.001 + voxel.seed * 8.1) * offset,
      dy: Math.cos(time * 0.0008 + voxel.seed * 6.4) * offset,
      alpha: 0.42 + 0.58 * progress,
      extrude: 0.82 + 0.28 * progress * (0.45 + 0.55 * wave),
    };
  }

  function smoothstep(value: number) {
    const clamped = Math.max(0, Math.min(1, value));
    return clamped * clamped * (3 - 2 * clamped);
  }

  function seeded(value: number) {
    let seed = (value + 1) * 374761393;
    seed = Math.imul(seed ^ (seed >>> 13), 1274126177);
    return ((seed ^ (seed >>> 16)) >>> 0) / 4294967296;
  }

  function mount(canvas: HTMLCanvasElement) {
    if (canvas.dataset.voxelReady === "true") return;

    const slot = canvas.closest("[data-cta-banner]")?.querySelector<HTMLElement>("[data-q-slot]");
    const footer = canvas.closest("footer");
    const reducedMotion = window.matchMedia(reducedMotionQuery);
    const context = canvas.getContext("2d");
    if (!context || !slot) return;

    canvas.dataset.voxelReady = "true";
    let frame = 0;
    let startedAt = 0;
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    const isPaused = () => document.hidden || canvas.closest("[inert]") !== null;

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      width = Math.max(1, Math.round(bounds.width));
      height = Math.max(1, Math.round(bounds.height));
      pixelRatio = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      if (!isPaused()) render(performance.now());
    };

    const render = (time: number) => {
      context.clearRect(0, 0, width, height);
      const canvasBounds = canvas.getBoundingClientRect();
      const slotBounds = slot.getBoundingClientRect();
      const slotWidth = slotBounds.width;
      if (slotWidth <= 0) return;

      const originX = slotBounds.left - canvasBounds.left;
      const originY = slotBounds.top - canvasBounds.top;
      const elapsed = reducedMotion.matches ? 9400 : startedAt === 0 ? 0 : time - startedAt;
      const cell = slotWidth / 3;
      const depth = cell * 0.08;
      const face = cell - depth;
      const extrusion = face * 0.22;
      const drawn = voxels.map((voxel) => {
        const currentPose = pose(voxel, elapsed, width < 1024 ? 0.7 : 1.15);
        return {
          x: originX + (voxel.col + currentPose.dx) * cell + depth / 2,
          y: originY + (voxel.row + currentPose.dy) * cell + depth / 2,
          z: voxel.row - voxel.col,
          pose: currentPose,
        };
      });

      drawn.sort((first, second) => first.z - second.z);
      for (const voxel of drawn) {
        drawVoxel(context, voxel.x, voxel.y, face, extrusion * voxel.pose.extrude, voxel.pose.alpha);
      }
    };

    const animate = (time: number) => {
      frame = 0;
      if (!isPaused()) {
        render(time);
        if (!reducedMotion.matches) frame = requestAnimationFrame(animate);
      }
    };
    const start = () => {
      if (startedAt === 0) startedAt = performance.now();
      if (frame !== 0 || isPaused()) {
        render(performance.now());
        return;
      }
      frame = requestAnimationFrame(animate);
    };
    const stop = () => {
      if (frame !== 0) cancelAnimationFrame(frame);
      frame = 0;
    };
    const restart = () => {
      stop();
      startedAt = performance.now();
      start();
    };
    const handleVisibility = () => (isPaused() ? stop() : start());
    const observer = new IntersectionObserver(
      (entries) => (entries.some((entry) => entry.isIntersecting) ? start() : stop()),
      { threshold: 0.05 },
    );
    const resizeObserver = new ResizeObserver(resize);
    const mutationObserver = footer
      ? new MutationObserver(handleVisibility)
      : null;

    resize();
    observer.observe(canvas);
    resizeObserver.observe(canvas);
    if (footer && mutationObserver) {
      mutationObserver.observe(footer, { attributes: true, attributeFilter: ["inert"] });
    }
    document.addEventListener("visibilitychange", handleVisibility);
    reducedMotion.addEventListener("change", restart);
  }

  function drawVoxel(
    context: CanvasRenderingContext2D,
    x: number,
    y: number,
    size: number,
    extrusion: number,
    alpha: number,
  ) {
    context.save();
    context.globalAlpha = alpha;
    context.beginPath();
    context.moveTo(x, y);
    context.lineTo(x + extrusion, y - extrusion);
    context.lineTo(x + size + extrusion, y - extrusion);
    context.lineTo(x + size, y);
    context.closePath();
    context.fillStyle = "#c2c2c2";
    context.fill();
    context.beginPath();
    context.moveTo(x + size, y);
    context.lineTo(x + size + extrusion, y - extrusion);
    context.lineTo(x + size + extrusion, y + size - extrusion);
    context.lineTo(x + size, y + size);
    context.closePath();
    context.fillStyle = "#3a3a3a";
    context.fill();
    context.fillStyle = "#ffffff";
    context.fillRect(x, y, size, size);
    context.restore();
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("[data-voxel-field]")) {
    mount(canvas);
  }
</script>
