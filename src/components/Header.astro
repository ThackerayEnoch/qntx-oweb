---
// Header.astro - Ultra-minimalist ASCII Control Bar
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-xs border-b border-black/8 px-4 sm:px-6">
  <div class="max-w-[1140px] mx-auto h-12 flex items-center justify-between gap-4 text-xs font-mono">
    
    <!-- Left: Identity -->
    <div class="flex items-center gap-3">
      <a href="#page-1" class="flex items-center gap-2 text-neutral-950 font-display text-sm tracking-wider hover:opacity-80 transition-opacity">
        <span class="w-1.5 h-1.5 rounded-xs bg-emerald-600 pulse-emerald inline-block"></span>
        <span>QNTX</span>
      </a>
      <span class="hidden md:inline text-[11px] text-neutral-400 border-l border-black/10 pl-3">
        [ SYSTEM SPEC ]
      </span>
    </div>

    <!-- Center: Look Selector (Squares / ASCII / Dots / Blocks / Binary) -->
    <nav class="flex items-center gap-1.5 overflow-x-auto py-1 no-scrollbar" aria-label="ASCII Look Switcher">
      <button
        type="button"
        class="look-btn active"
        data-look-btn="squares"
        aria-pressed="true"
        title="Switch to Squares characters"
      >
        <span class="select-none text-emerald-700">·▪■</span>
        <span class="hidden sm:inline">Squares</span>
      </button>

      <button
        type="button"
        class="look-btn"
        data-look-btn="ascii"
        aria-pressed="false"
        title="Switch to ASCII characters"
      >
        <span class="select-none text-neutral-400">*#$</span>
        <span class="hidden sm:inline">ASCII</span>
      </button>

      <button
        type="button"
        class="look-btn"
        data-look-btn="dots"
        aria-pressed="false"
        title="Switch to Halftone Dots"
      >
        <span class="select-none text-neutral-400">·•●</span>
        <span class="hidden sm:inline">Dots</span>
      </button>

      <button
        type="button"
        class="look-btn hidden md:inline-flex"
        data-look-btn="blocks"
        aria-pressed="false"
        title="Switch to Blocks characters"
      >
        <span class="select-none text-neutral-400">░▒▓</span>
        <span>Blocks</span>
      </button>

      <button
        type="button"
        class="look-btn hidden lg:inline-flex"
        data-look-btn="binary"
        aria-pressed="false"
        title="Switch to Binary characters"
      >
        <span class="select-none text-neutral-400">01</span>
        <span>Binary</span>
      </button>
    </nav>

    <!-- Right: Page Jumps & GitHub -->
    <div class="flex items-center gap-3 shrink-0">
      <div class="flex items-center gap-1 bg-neutral-100 p-0.5 border border-black/10 text-[11px]">
        <a
          href="#page-1"
          data-page-link="page-1"
          class="px-1.5 py-0.5 text-neutral-900 font-bold hover:text-black transition-colors"
          title="Jump to Section 01 (Core)"
        >
          01
        </a>
        <span class="text-neutral-300">/</span>
        <a
          href="#page-2"
          data-page-link="page-2"
          class="px-1.5 py-0.5 text-neutral-400 hover:text-black transition-colors"
          title="Jump to Section 02 (Primitives)"
        >
          02
        </a>
      </div>

      <a
        href="https://github.com/qntx"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2 py-1 text-[11px] text-neutral-700 hover:text-black border border-black/15 hover:border-black bg-white transition-all shadow-2xs"
        aria-label="GitHub Repository"
      >
        <span>GITHUB</span>
        <span class="text-neutral-400">↗</span>
      </a>
    </div>

  </div>
</header>
