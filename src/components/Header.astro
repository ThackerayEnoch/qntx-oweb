---
// Header.astro - Pure Minimalist Web3 Header
---

<header class="w-full bg-transparent px-6 sm:px-10 pt-6 sm:pt-8 select-none">
  <div class="max-w-[1240px] mx-auto flex items-center justify-between">
    
    <!-- Left: Logo Identifier with Enlaraged favicon.svg -->
    <a
      href="/"
      class="flex items-center gap-3 text-neutral-950 hover:opacity-80 transition-opacity"
      aria-label="QuantX Home"
    >
      <img src="/favicon.svg" alt="QuantX Logo" class="w-8 h-8 sm:w-9 sm:h-9 shrink-0" />
      <span class="font-medium tracking-wider text-base sm:text-lg">QuantX</span>
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 pulse-emerald inline-block"></span>
    </a>

    <!-- Right: Navigation Links (Larger typography, clear & restrained) -->
    <nav class="flex items-center gap-5 sm:gap-8 tracking-wider text-sm sm:text-base" aria-label="Main Navigation">
      <a
        href="https://docs.qntx.org"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-950 transition-colors uppercase"
      >
        DOCS
      </a>

      <a
        href="https://github.com/qntx"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-950 transition-colors inline-flex items-center gap-1 uppercase"
        aria-label="GitHub Repository"
      >
        <span>GITHUB</span>
        <span class="text-neutral-400 text-xs sm:text-sm">↗</span>
      </a>

      <a
        href="https://docs.qntx.org"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-950 hover:opacity-70 transition-opacity inline-flex items-center gap-1 font-medium uppercase"
        aria-label="Get Started"
      >
        <span>GET STARTED</span>
        <span class="text-neutral-400 text-xs sm:text-sm">→</span>
      </a>
    </nav>

  </div>
</header>
