---
// Header.astro - Pure Minimalist Header
---

<header class="w-full bg-transparent px-6 sm:px-10 pt-6 sm:pt-8 select-none">
  <div class="max-w-[1200px] mx-auto flex items-center justify-between text-xs font-mono">
    <!-- Left: Logo Identifier -->
    <a
      href="/"
      class="flex items-center gap-2.5 text-neutral-950 hover:opacity-75 transition-opacity"
      aria-label="QuantX Home"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 pulse-emerald inline-block"></span>
      <span class="font-semibold tracking-wider text-sm">QuantX</span>
    </a>

    <!-- Right: GitHub Link -->
    <a
      href="https://github.com/qntx"
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-500 hover:text-neutral-950 transition-colors inline-flex items-center gap-1 tracking-wider"
      aria-label="GitHub Repository"
    >
      <span>GITHUB</span>
      <span class="text-neutral-400">↗</span>
    </a>
  </div>
</header>
