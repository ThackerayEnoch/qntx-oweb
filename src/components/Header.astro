---
// Header.astro - Pure Minimalist Header with Favicon, Docs & Get Started
---

<header class="w-full bg-transparent px-6 sm:px-10 pt-6 sm:pt-8 select-none">
  <div class="max-w-[1200px] mx-auto flex items-center justify-between text-xs font-mono">
    
    <!-- Left: Logo Identifier with favicon.svg -->
    <a
      href="/"
      class="flex items-center gap-2.5 text-neutral-950 hover:opacity-75 transition-opacity"
      aria-label="QuantX Home"
    >
      <img src="/favicon.svg" alt="QuantX Logo" class="w-4 h-4 shrink-0" />
      <span class="font-semibold tracking-wider text-sm">QuantX</span>
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 pulse-emerald inline-block"></span>
    </a>

    <!-- Right: Navigation Links (DOCS, GITHUB, GET STARTED) -->
    <nav class="flex items-center gap-4 sm:gap-6 tracking-wider" aria-label="Main Navigation">
      <a
        href="https://github.com/qntx#readme"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-950 transition-colors"
      >
        DOCS
      </a>

      <a
        href="https://github.com/qntx"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-950 transition-colors inline-flex items-center gap-1"
        aria-label="GitHub Repository"
      >
        <span>GITHUB</span>
        <span class="text-neutral-400">↗</span>
      </a>

      <a
        href="https://github.com/qntx"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-950 hover:opacity-70 transition-opacity inline-flex items-center gap-1 font-medium"
        aria-label="Get Started"
      >
        <span>GET STARTED</span>
        <span class="text-neutral-400">→</span>
      </a>
    </nav>

  </div>
</header>
