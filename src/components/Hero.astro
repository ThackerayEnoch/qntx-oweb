---
const command = 'npm i @qntx/openai';
---

<section class="relative pt-24 pb-16 md:pt-30 md:pb-24 bg-white overflow-hidden" id="hero">
  <!-- Grid background with subtle fade-in -->
  <div
    class="hero-grid-enter absolute inset-0 bg-[linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)] bg-[size:3.75rem_3.75rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none z-0"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Step 0 (0ms): Live Protocol Status Pill -->
    <div
      class="hero-enter inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-neutral-200 bg-neutral-50 mb-7"
      style="animation-delay: 0ms;"
    >
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
      <span class="font-label-tag text-label-tag tracking-wider text-neutral-700 uppercase" data-scramble>
        x402 Protocol v0.1 Live on Monad Testnet
      </span>
    </div>

    <!-- Step 1 (70ms): Headline H1 -->
    <h1
      class="hero-enter font-display text-display-mobile md:text-display tracking-tight text-zinc-950 max-w-4xl xl:max-w-5xl font-semibold mb-6"
      style="animation-delay: 70ms;"
    >
      Building the Economic Layer for Autonomous AI Agents.
    </h1>

    <!-- Step 2 (140ms): Subtitle -->
    <p
      class="hero-enter font-body-lg text-body-lg text-neutral-600 max-w-2xl xl:max-w-3xl mb-2.5"
      style="animation-delay: 140ms;"
    >
      Open protocols and infrastructure for AI agents to transact, collaborate, govern, and evolve autonomously on-chain.
    </p>

    <!-- Step 3 (210ms): Tagline -->
    <p
      class="hero-enter font-code-lg text-code-lg text-neutral-500 font-medium mb-11"
      style="animation-delay: 210ms;"
    >
      Agents earn. Agents pay. Agents scale.
    </p>

    <!-- Step 4 (280ms): Action Buttons (Rounded-full) -->
    <div
      class="hero-enter flex flex-wrap items-center gap-4 mb-14"
      style="animation-delay: 280ms;"
    >
      <a
        class="px-8 py-3.5 bg-black text-white rounded-full font-code-sm text-code-sm font-medium hover:bg-neutral-800 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] flex items-center gap-2"
        href="https://github.com/qntx"
        rel="noreferrer"
        target="_blank"
      >
        <span>Explore GitHub</span>
        <span class="material-symbols-outlined text-sm leading-none" data-icon="arrow_outward">arrow_outward</span>
      </a>
      <a
        class="px-8 py-3.5 bg-white text-zinc-950 border border-neutral-300 rounded-full font-code-sm text-code-sm font-medium hover:border-black transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] flex items-center gap-2"
        href="https://github.com/qntx"
        rel="noreferrer"
        target="_blank"
      >
        <span>Developer Docs</span>
        <span class="material-symbols-outlined text-sm leading-none" data-icon="description">description</span>
      </a>
    </div>

    <!-- Step 5 (350ms): Terminal Box with Blinking Cursor & Micro-Animation -->
    <div
      class="hero-enter max-w-2xl xl:max-w-3xl bg-neutral-50 border border-neutral-200 rounded-2xl overflow-hidden"
      style="animation-delay: 350ms;"
    >
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-neutral-200 bg-white">
        <div class="flex items-center gap-2 font-code-sm text-code-sm text-neutral-600">
          <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
          <span>bash</span>
        </div>
        <button
          type="button"
          class="font-code-sm text-code-sm text-neutral-500 hover:text-black transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] flex items-center gap-1 cursor-pointer"
          id="copy-btn"
          data-command={command}
        >
          <span class="material-symbols-outlined text-xs leading-none" data-icon="content_copy" id="copy-btn-icon">content_copy</span>
          <span id="copy-btn-text">Copy</span>
        </button>
      </div>
      <div class="p-4.5 font-code-sm text-code-sm space-y-2">
        <div class="flex items-center gap-2 text-zinc-950">
          <span class="text-neutral-400 select-none">$</span>
          <div class="flex items-center">
            <span class="font-medium text-zinc-950" id="terminal-command" data-full-command={command}>{command}</span>
            <span class="terminal-cursor inline-block w-2 h-4.5 bg-zinc-900 ml-1 select-none" aria-hidden="true"></span>
          </div>
        </div>
        <div class="text-neutral-500 text-xs">
          # Transparent HTTP 402 micropayments on Monad Permit2
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyBtnIcon = document.getElementById('copy-btn-icon');
  const terminalCommand = document.getElementById('terminal-command');

  // Subtle terminal typing micro-animation on entrance
  if (terminalCommand) {
    const fullText = terminalCommand.getAttribute('data-full-command') || 'npm i @qntx/openai';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      terminalCommand.textContent = '';
      setTimeout(() => {
        let i = 0;
        const timer = setInterval(() => {
          if (i < fullText.length) {
            terminalCommand.textContent += fullText[i];
            i++;
          } else {
            clearInterval(timer);
          }
        }, 35);
      }, 420);
    }
  }

  // Copy interaction with visual feedback
  if (copyBtn && copyBtnText && copyBtnIcon) {
    copyBtn.addEventListener('click', async () => {
      const command = copyBtn.getAttribute('data-command') || 'npm i @qntx/openai';
      try {
        await navigator.clipboard.writeText(command);
        copyBtnText.textContent = 'Copied';
        copyBtnIcon.textContent = 'check';
        copyBtnIcon.setAttribute('data-icon', 'check');
        setTimeout(() => {
          copyBtnText.textContent = 'Copy';
          copyBtnIcon.textContent = 'content_copy';
          copyBtnIcon.setAttribute('data-icon', 'content_copy');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  }
</script>
