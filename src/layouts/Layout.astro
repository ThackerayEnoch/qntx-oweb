---
// Layout.astro - Clean Technical Paper Shell
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "QNTX // Autonomous Agent Protocol",
  description = "Minimalist protocol specification and runtime for autonomous AI agents.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preload Fonts -->
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-white text-neutral-950 font-body min-h-screen relative antialiased">
    <!-- Side Technical Guide Rails -->
    <div class="side-rail-left" aria-hidden="true"></div>
    <div class="side-rail-right" aria-hidden="true"></div>

    <slot />

    <!-- Client Scripts -->
    <script src="../scripts/ascii-canvas.ts"></script>
    <script src="../scripts/swarm-canvas.ts"></script>
    <script src="../scripts/nav.ts"></script>
  </body>
</html>
