---
import { ctaData } from '../home.data';

const { badge, title, description, buttonText, buttonHref } = ctaData;
---

<section class="py-24 md:py-32 bg-white text-center">
  <div class="max-w-5xl mx-auto px-6 flex flex-col items-center">
    <!-- Centered Badge Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-neutral-200 bg-neutral-50 mb-7">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
      <span
        class="font-label-tag text-label-tag tracking-wider text-neutral-700 uppercase font-medium"
        data-scramble
      >
        {badge}
      </span>
    </div>

    <!-- Headline -->
    <h2 class="font-display text-display-mobile md:text-display tracking-tight text-zinc-950 font-semibold mb-6 max-w-4xl">
      {title}
    </h2>

    <!-- Description -->
    <p class="font-body-lg text-body-lg text-neutral-600 max-w-3xl mb-11">
      {description}
    </p>

    <!-- CTA Button -->
    <a
      class="px-9 py-4 bg-black text-white rounded-full font-code-sm text-code-sm font-medium hover:bg-neutral-800 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] inline-flex items-center gap-2 shadow-sm"
      href={buttonHref}
      rel="noreferrer"
      target="_blank"
    >
      <span>{buttonText}</span>
    </a>
  </div>
</section>
