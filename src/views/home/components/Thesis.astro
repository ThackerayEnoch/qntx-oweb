---
import ThesisCard from './ThesisCard.astro';
import { thesisData } from '../home.data';

const { sectionTag, title, subtitle, withoutX402, withX402 } = thesisData;
---

<section class="w-full py-24 md:py-32 bg-neutral-50" id="x402">
  <div class="max-w-7xl mx-auto px-6">
    <div class="font-code-sm text-code-sm text-neutral-500 tracking-wider uppercase mb-3.5" data-scramble>
      {sectionTag}
    </div>
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-zinc-950 tracking-tight font-semibold mb-2.5">
      {title}
    </h2>
    <p class="font-code-lg text-code-lg text-neutral-600 mb-12">
      {subtitle}
    </p>

    <!-- Contrast Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      <ThesisCard
        badge={withoutX402.badge}
        title={withoutX402.title}
        description={withoutX402.description}
        items={withoutX402.items}
        theme={withoutX402.theme}
      />
      <ThesisCard
        badge={withX402.badge}
        title={withX402.title}
        description={withX402.description}
        items={withX402.items}
        theme={withX402.theme}
      />
    </div>
  </div>
</section>
