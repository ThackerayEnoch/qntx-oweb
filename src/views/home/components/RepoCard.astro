---
import type { RepoItem } from '../home.types';

type Props = RepoItem;

const { href, name, tags, description, colSpan = '' } = Astro.props;
---

<a
  class={`group bg-white border border-neutral-200 hover:border-neutral-900 p-5 md:p-5.5 rounded-xl transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col justify-between ${colSpan}`.trim()}
  href={href}
  rel="noreferrer"
  target="_blank"
>
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2 font-code-lg text-code-lg font-medium text-zinc-950">
        <span class="material-symbols-outlined text-sm leading-none" data-icon="folder_code">folder_code</span>
        <span>{name}</span>
      </div>
      {tags.length === 1 ? (
        <span class="font-label-tag text-label-tag px-2 py-0.5 rounded border border-neutral-200 bg-neutral-50 text-neutral-700 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:bg-neutral-900 group-hover:text-white group-hover:border-neutral-900">
          {tags[0]}
        </span>
      ) : (
        <div class="flex gap-1.5">
          {tags.map((tag) => (
            <span class="font-label-tag text-label-tag px-2 py-0.5 rounded border border-neutral-200 bg-neutral-50 text-neutral-700 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:bg-neutral-900 group-hover:text-white group-hover:border-neutral-900">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    <p class="font-body-sm text-body-sm text-neutral-600 mb-4 leading-relaxed">
      {description}
    </p>
  </div>
  <div class="flex items-center gap-1.5 font-code-sm text-code-sm text-neutral-500 group-hover:text-black transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]">
    <span>View Source</span>
    <span
      class="material-symbols-outlined text-xs leading-none transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-[2px]"
      data-icon="arrow_forward"
    >
      arrow_forward
    </span>
  </div>
</a>
