---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import PageOne from '@/components/PageOne.astro';
import '@/styles/global.css';
---

<Layout>
  <div class="min-h-screen flex flex-col justify-between">
    <Header />

    <main class="flex-1 flex flex-col items-center justify-center max-w-[1140px] w-full mx-auto px-4 sm:px-6">
      <PageOne />
    </main>

    <!-- Subtle Empty Buffer for True Viewport Center Alignment -->
    <div class="h-6 sm:h-8" aria-hidden="true"></div>
  </div>
</Layout>
